# Railway Backend Variables
# Use Railway reference variables from the MySQL service where possible.

# App port is provided automatically by Railway as PORT.
# PORT=8081

# Map these to your Railway MySQL service variables:
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_NAME=${{MySQL.MYSQLDATABASE}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# Your real Vercel frontend domain. Add multiple domains separated by commas.
CORS_ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app

# Create a long random secret (at least 32+ bytes; preferably 64+ random chars).
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_PRODUCTION_SECRET

# Change bootstrap admin credentials before first public deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Attach a Railway Volume at /data, then store user-uploaded files here.
FILE_STORAGE_DIR=/data/uploads

# Optional metadata used by website assistant
APP_OWNER=DICP Insurance
APP_DEVELOPMENT_INFO=Digital Insurance Claim and Premiums Portal

# Local CSV chatbot works without an external AI API key.
# XAI_API_KEY=
# AI_MODEL=grok-3-mini
