# Vercel Production Environment Variables
# Add these in Vercel -> Project -> Settings -> Environment Variables.

# IMPORTANT: include /api at the end because Spring Boot uses context-path=/api
VITE_API_BASE_URL=https://YOUR-BACKEND.up.railway.app/api

# Python analytics service is a separate Railway public service.
VITE_SALARY_API_URL=https://YOUR-ANALYTICS.up.railway.app

# EmailJS (only if you use email OTP/reset)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_VERIFY_TEMPLATE=
VITE_EMAILJS_RESET_TEMPLATE=

# Optional Google login
# VITE_GOOGLE_CLIENT_ID=
